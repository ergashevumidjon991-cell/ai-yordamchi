# --- Telegram bot (@BotFather dan olinadi) ---
BOT_TOKEN=123456:ABC...
# Sizning Telegram ID raqamingiz (@userinfobot dan bilib olasiz). Bot faqat sizga javob beradi.
OWNER_ID=123456789
# Bot sizga qanday murojaat qilsin
OWNER_NAME=Ismingiz

# --- Claude (console.anthropic.com dan API kalit) ---
ANTHROPIC_API_KEY=sk-ant-...
# claude-opus-5-5 eng aqlli. Byudjetni tejash uchun claude-haiku-5-5 qo'ying.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# --- ElevenLabs (elevenlabs.io): o'zbekchani yaxshi tushunadi va tabiiy ovozda gapiradi ---
# Kalit bo'lsa, ovozni tanish ham, bot ovozi ham ElevenLabs orqali ishlaydi.
# Kredit tugasa, bot avtomatik ravishda bepul Microsoft ovoziga o'tadi.
ELEVEN_API_KEY=
# Ovoz ID si (elevenlabs.io > Voices dan erkak ovozni tanlab, ID sini nusxalang)
ELEVEN_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVEN_TTS_MODEL=eleven_v4

# --- Zaxira: ovozni matnga aylantirish (Groq Whisper). ElevenLabs bo'lmasa ishlatiladi ---
STT_API_KEY=gsk_...
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3

# --- Zaxira bot ovozi (bepul, Microsoft Edge) ---
TTS_VOICE=uz-UZ-SardorNeural

# --- Uyg'otish uchun qo'ng'iroq qiladigan ikkinchi Telegram akkaunt (my.telegram.org) ---
# Bo'sh qoldirsangiz, bot qo'ng'iroq o'rniga ovozli xabarlar bilan uyg'otadi.
USERBOT_API_ID=
USERBOT_API_HASH=

TIMEZONE=Asia/Tashkent
DATA_DIR=data

# Gemini (AI_PROVIDER=gemini bo'lsa). Kalitni faqat serverdagi .env ga yozing, bu yerga emas.
AI_PROVIDER=claude
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Qo'ng'iroqdagi javoblar uchun alohida "miya" (bo'sh = AI_PROVIDER bilan bir xil)
CALL_AI_PROVIDER=
# Ovozni matnga va matnni ovozga: eleven yoki gemini
VOICE_PROVIDER=eleven
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Charon
